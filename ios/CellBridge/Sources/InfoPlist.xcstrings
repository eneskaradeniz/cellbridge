{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CellBridge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CellBridge"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows who is calling or texting and lets you pick a number from your contacts. Contacts stay on this phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin aradığını ya da mesaj attığını gösterir ve rehberinden numara seçmeni sağlar. Kişiler bu telefonda kalır."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your voice to the call on the phone you are bridging."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesini, köprülediğin telefondaki aramaya iletir."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talks to the CellBridge host on the local network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ağdaki CellBridge ana telefonuyla konuşur."
          }
        }
      }
    }
  }
}